{
  "name": "geography-game-api",
  "version": "2.1.0",
  "private": true,
  "description": "Backend API for GeoAIGames (Atlas Quest and the five-level geography platform)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "content:check": "node scripts/content.js check",
    "content:import": "node scripts/content.js import",
    "questions": "node scripts/questions.js",
    "admin:unlock": "node scripts/admin-unlock.js"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "prisma": "7.10.1"
  }
}
