    "db:format": "prisma format",
    "db:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "prisma": "7.10.1"
  }
}
