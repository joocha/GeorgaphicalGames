# Copy to .env and adjust. In production this file is loaded by systemd
# (EnvironmentFile=), so use plain KEY=value lines: no `export`, no spaces
# around `=`.

NODE_ENV=production

# The API must only listen on loopback. Nginx proxies /api/ to it.
HOST=127.0.0.1
PORT=3020

# PostgreSQL connection (used by Prisma; see docs/database.md).
# Local example. In production, use a dedicated role with a strong password.
DATABASE_URL=postgresql://atlas:CHANGE_ME@127.0.0.1:5432/atlas_quest
