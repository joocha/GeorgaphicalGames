# Copy to .env and adjust. In production this file is loaded by systemd
# (EnvironmentFile=), so use plain KEY=value lines: no `export`, no spaces
# around `=`.

NODE_ENV=production

# The API must only listen on loopback. Nginx proxies /api/ to it.
HOST=127.0.0.1
PORT=3020

# PostgreSQL connection (used by Prisma; see docs/database.md).
# Local example. In production, use a dedicated role with a strong password.
DATABASE_URL=postgresql://atlas:CHANGE_ME@127.0.0.1:5432/atlas_quest

# Telegram login. The bot token from @BotFather verifies the Mini App's
# initData. Keep it secret: anyone who has it can sign in as any player.
TELEGRAM_BOT_TOKEN=
# Reject initData older than this many seconds (default 86400 = 24 h).
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Signs the API access tokens. At least 32 random characters, e.g.
#   openssl rand -hex 32
# Changing it signs every player out (they sign in again on next launch).
SESSION_SECRET=
# Access token lifetime in seconds (default 86400 = 24 h).
SESSION_TTL_SECONDS=86400
