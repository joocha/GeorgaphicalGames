// Atlas Quest: PostgreSQL schema.
//
// Full documentation (ER diagram, relationships, indexes, constraints and the
// mapping of the existing games onto the catalog): ../docs/database.md
//
// Conventions
// - Application entities use UUID primary keys generated by PostgreSQL
//   (gen_random_uuid(), built in since PostgreSQL 13).
// - Every timestamp is `timestamptz`: PostgreSQL stores an absolute instant
//   (UTC), so readings never depend on the server or session time zone.
// - Tables and columns are snake_case in the database, camelCase in Prisma.
// - Game types and modes are identified by flexible string codes stored as
//   rows, not by enums, so a new game or mode never needs a schema change.
// - CHECK constraints and triggers can't be expressed in Prisma. They live in
//   the migration SQL and are listed in the documentation.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Lifecycle of one play-through. `completed` is terminal (enforced by trigger).
enum GameSessionStatus {
  in_progress
  completed
  abandoned

  @@map("game_session_status")
}

// Delivery state of an outbox event.
enum OutboxEventStatus {
  pending
  processing
  published
  failed

  @@map("outbox_event_status")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

// A player. Deliberately holds no provider-specific identifiers: Telegram IDs,
// e-mail logins etc. live only in auth_identities.
model User {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile    UserProfile?
  identities AuthIdentity[]
  sessions   GameSession[]
  results    GameResult[]

  @@map("users")
}

// Display data, one row per user (1:1, shares the user's primary key).
model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String?  @map("display_name") @db.VarChar(64)
  avatarUrl   String?  @map("avatar_url")
  // BCP 47 language tag, e.g. Telegram's `language_code`.
  locale      String?  @db.VarChar(35)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// The single source of external authentication identities. One user may own
// several identities (e.g. Telegram + a future web login), which is how the
// same player is recognised in both the Telegram Mini App and the Web Game.
model AuthIdentity {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  // Lower-case provider code, e.g. "telegram".
  provider       String    @db.VarChar(32)
  // The provider's stable user ID, stored as text (Telegram IDs are 64-bit).
  providerUserId String    @map("provider_user_id") @db.VarChar(255)
  // Last snapshot of provider-specific fields (username, language_code,
  // is_premium, ...). Varies per provider, hence JSONB.
  providerData   Json?     @map("provider_data") @db.JsonB
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

// ---------------------------------------------------------------------------
// Game catalog (reference data, seeded by migration)
// ---------------------------------------------------------------------------

// A distinct game with its own rules. The Telegram Mini App and the Web Game
// are different games, not two skins of one.
model Game {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?
  // Frontend that ships this game: "telegram" (index.html) or "web" (web/).
  platform    String   @db.VarChar(32)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  modes GameMode[]

  @@map("games")
}

// A playable variant of a game: a difficulty level (Telegram) or an
// expedition (Web). Sessions and results point here.
model GameMode {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId           String   @map("game_id") @db.Uuid
  // Unique within its game, e.g. "easy", "capitals", "border_journey".
  code             String   @db.VarChar(64)
  name             String   @db.VarChar(120)
  description      String?
  // Only set where the existing game has explicit difficulty levels.
  difficulty       String?  @db.VarChar(32)
  // Rounds (questions or journeys) in one session.
  roundsPerSession Int      @map("rounds_per_session")
  // Result column the existing frontend uses as the player's "best":
  // "score", "correct_count" or "stars".
  bestMetric       String   @map("best_metric") @db.VarChar(32)
  // Mode rules: scoring formula, question mix, pools, thresholds. Differs
  // per mode, hence JSONB. Documentation only; the frontend stays the
  // authority on game rules for now.
  config           Json     @default("{}") @db.JsonB
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  game     Game          @relation(fields: [gameId], references: [id], onDelete: Restrict)
  sessions GameSession[]
  results  GameResult[]

  @@unique([gameId, code])
  @@map("game_modes")
}

// ---------------------------------------------------------------------------
// Gameplay
// ---------------------------------------------------------------------------

// One play-through by one user of one game mode.
model GameSession {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  gameModeId     String            @map("game_mode_id") @db.Uuid
  status         GameSessionStatus @default(in_progress)
  // Where it was played: "telegram" (inside the Telegram client) or "web"
  // (a browser). The Telegram Mini App also opens in a normal browser, so
  // this is not implied by the game.
  clientPlatform String            @map("client_platform") @db.VarChar(32)
  startedAt      DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  // Set when the session becomes completed or abandoned.
  endedAt        DateTime?         @map("ended_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameMode GameMode    @relation(fields: [gameModeId], references: [id], onDelete: Restrict)
  result   GameResult?

  // Target of game_results' composite foreign key: guarantees a result's
  // user and mode are exactly those of its session.
  @@unique([id, userId, gameModeId])
  @@index([userId, startedAt(sort: Desc)])
  @@index([gameModeId, startedAt])
  @@map("game_sessions")
}

// The final result of a completed session. Append-only history: a new best
// score adds a row, it never overwrites an earlier one.
model GameResult {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // UNIQUE: at most one result per session.
  sessionId    String   @unique @map("session_id") @db.Uuid
  // Copied from the session (enforced by the composite FK) so leaderboards
  // and statistics don't need to join game_sessions.
  userId       String   @map("user_id") @db.Uuid
  gameModeId   String   @map("game_mode_id") @db.Uuid
  // Points, as shown in-game.
  score        Int
  // Correctly answered rounds (quiz modes) or successful journeys.
  correctCount Int      @map("correct_count")
  totalRounds  Int      @map("total_rounds")
  // Border journey only: 0-3 stars per journey.
  stars        Int?
  // Quiz modes only: longest run of consecutive correct answers.
  bestStreak   Int?     @map("best_streak")
  // Web Game only: XP awarded (drives the web rank ladder).
  xpEarned     Int?     @map("xp_earned")
  durationMs   Int?     @map("duration_ms")
  // Mode-specific breakdown (per-journey moves and hints, question kinds,
  // ...). Not used for ranking.
  details      Json?    @db.JsonB
  // Always equals the session's ended_at (set by trigger).
  completedAt  DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session  GameSession @relation(fields: [sessionId, userId, gameModeId], references: [id, userId, gameModeId], onDelete: Cascade, onUpdate: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gameMode GameMode    @relation(fields: [gameModeId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  // Needed by Prisma for the composite 1:1 relation above. session_id alone
  // is already unique; this mirrors game_sessions' composite key.
  @@unique([sessionId, userId, gameModeId])
  // Leaderboard per mode: best scores first, earlier achievement wins ties.
  @@index([gameModeId, score(sort: Desc), completedAt])
  // A player's history and personal bests per mode.
  @@index([userId, gameModeId, completedAt(sort: Desc)])
  @@map("game_results")
}

// ---------------------------------------------------------------------------
// Integration
// ---------------------------------------------------------------------------

// Transactional outbox. Rows are written in the same transaction as the
// change they describe; a separate dispatcher delivers them (e.g. to an n8n
// webhook) at least once. `id` is the event ID consumers use to deduplicate.
model OutboxEvent {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // What changed, e.g. aggregate_type "game_result" + its id.
  aggregateType String            @map("aggregate_type") @db.VarChar(64)
  aggregateId   String            @map("aggregate_id") @db.Uuid
  // Dotted event name, e.g. "game_result.recorded".
  eventType     String            @map("event_type") @db.VarChar(128)
  // Version of the payload shape for this event type.
  eventVersion  Int               @default(1) @map("event_version")
  payload       Json              @db.JsonB
  status        OutboxEventStatus @default(pending)
  attempts      Int               @default(0)
  // Earliest time of the next delivery attempt (retry back-off).
  availableAt   DateTime          @default(now()) @map("available_at") @db.Timestamptz(6)
  // Claim by a dispatcher; a stale lock means the dispatcher died.
  lockedAt      DateTime?         @map("locked_at") @db.Timestamptz(6)
  lockedBy      String?           @map("locked_by") @db.VarChar(128)
  publishedAt   DateTime?         @map("published_at") @db.Timestamptz(6)
  lastError     String?           @map("last_error")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  // Dispatcher polling: WHERE status = 'pending' AND available_at <= now().
  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}
